{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WaterSmart (Windows Desktop)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": ["-d", "windows"],
      "console": "debugConsole",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "WaterSmart (Chrome / Web)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": ["-d", "chrome", "--web-port", "5000"],
      "console": "debugConsole",
      "cwd": "${workspaceFolder}"
    }
  ]
}
